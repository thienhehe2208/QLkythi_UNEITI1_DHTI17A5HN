@* Module 2 - Nguyễn Tiến Quang. Mã sinh viên cần bổ sung theo bảng phân công. *@
@model KyThiFormViewModel
@{
    ViewData["Title"] = "Sửa kỳ thi";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Kỳ thi</a></li><li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.MaKyThi">Chi tiết</a></li><li class="breadcrumb-item active">Sửa</li></ol></nav>
        <h1>Sửa kỳ thi</h1>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.MaKyThi" method="post" class="card">
    <input asp-for="MaKyThi" type="hidden" />
    <div class="card-body"><partial name="_Form" model="Model" /></div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Details" asp-route-id="@Model.MaKyThi" class="btn btn-light">Hủy</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i>Lưu thay đổi</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
