@* Module 2 - Nguyễn Tiến Quang. Mã sinh viên cần bổ sung theo bảng phân công. *@
@model KyThi
@{
    ViewData["Title"] = "Xóa kỳ thi";
    var soHoSo = ViewBag.SoHoSo as int? ?? 0;
}

<div class="page-header"><div><nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Kỳ thi</a></li><li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.MaKyThi">Chi tiết</a></li><li class="breadcrumb-item active">Xóa</li></ol></nav><h1>Xóa kỳ thi</h1></div></div>
<div class="card" style="max-width:680px">
    <div class="card-body">
        <h2 class="h5">@Model.TenKyThi</h2>
        <p class="text-muted">@Model.ChungChi?.TenChungChi · @Model.CapDoThi</p>
        @if (soHoSo > 0)
        {
            <div class="alert alert-warning mb-0"><i class="bi bi-shield-lock me-2"></i>Không thể xóa vì kỳ thi đã có <strong>@soHoSo hồ sơ</strong>. Hãy đóng kỳ thi để giữ lịch sử.</div>
        }
        else
        {
            <div class="alert alert-danger mb-0"><i class="bi bi-exclamation-octagon-fill me-2"></i>Kỳ thi sẽ bị xóa vĩnh viễn và không thể khôi phục.</div>
        }
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Details" asp-route-id="@Model.MaKyThi" class="btn btn-light">Quay lại</a>
        @if (soHoSo == 0) { <form asp-action="Delete" asp-route-id="@Model.MaKyThi" method="post"><button class="btn btn-danger" type="submit"><i class="bi bi-trash"></i>Xóa vĩnh viễn</button></form> }
    </div>
</div>
