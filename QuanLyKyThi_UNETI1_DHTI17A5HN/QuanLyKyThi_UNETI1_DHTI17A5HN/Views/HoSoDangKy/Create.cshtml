@model HoSoDangKyFormViewModel
@{ ViewData["Title"] = "Đăng ký dự thi"; }
<div class="page-header"><div><h1>Đăng ký dự thi</h1><p class="page-subtitle">Chọn kỳ thi đang nhận hồ sơ và nhập mục đích dự thi.</p></div></div>
<form asp-action="Create" method="post" class="card" style="max-width:860px"><div class="card-body"><div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div><div class="row g-3">
    <div class="col-12"><label asp-for="MaKyThi" class="form-label required"></label><select asp-for="MaKyThi" asp-items="ViewBag.DanhSachKyThi" class="form-select"><option value="0">-- Chọn kỳ thi --</option></select><span asp-validation-for="MaKyThi" class="text-danger"></span></div>
    <div class="col-12"><label asp-for="MucDichDuThi" class="form-label required"></label><textarea asp-for="MucDichDuThi" class="form-control" rows="4"></textarea><span asp-validation-for="MucDichDuThi" class="text-danger"></span></div>
    <div class="col-12"><label asp-for="GhiChu" class="form-label"></label><textarea asp-for="GhiChu" class="form-control" rows="3"></textarea><span asp-validation-for="GhiChu" class="text-danger"></span></div>
</div></div><div class="card-footer d-flex justify-content-end gap-2"><a asp-action="Index" class="btn btn-light">Hủy</a><button class="btn btn-primary" type="submit"><i class="bi bi-send"></i>Nộp hồ sơ</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

