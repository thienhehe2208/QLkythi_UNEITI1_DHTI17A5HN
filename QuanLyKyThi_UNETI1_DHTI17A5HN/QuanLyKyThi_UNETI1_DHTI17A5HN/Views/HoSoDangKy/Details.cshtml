@model HoSoDangKyThi
@{
    ViewData["Title"] = $"Hồ sơ HS-{Model.MaHoSo}";
    var coTheHuy = ViewBag.CoTheHuy as bool? ?? false;
}
<div class="page-header"><div><div class="d-flex align-items-center gap-2"><h1>Hồ sơ HS-@Model.MaHoSo</h1><partial name="_BadgeTrangThai" model="Model.TrangThai" /></div><p class="page-subtitle">Nộp lúc @Model.NgayNop.ToString("dd/MM/yyyy HH:mm")</p></div></div>
<div class="row g-3"><div class="col-lg-8"><div class="card"><div class="card-header">Thông tin đăng ký</div><div class="card-body py-1"><dl class="info-list">
    <div class="row"><dt class="col-sm-4">Thí sinh</dt><dd class="col-sm-8">@Model.ThiSinh?.HoTen</dd></div>
    <div class="row"><dt class="col-sm-4">Kỳ thi</dt><dd class="col-sm-8">@Model.KyThi?.TenKyThi<div class="text-muted small">@Model.KyThi?.ChungChi?.TenChungChi</div></dd></div>
    <div class="row"><dt class="col-sm-4">Mục đích dự thi</dt><dd class="col-sm-8" style="white-space:pre-line">@Model.MucDichDuThi</dd></div>
    <div class="row"><dt class="col-sm-4">Ghi chú</dt><dd class="col-sm-8" style="white-space:pre-line">@(Model.GhiChu ?? "Không có")</dd></div>
    <div class="row"><dt class="col-sm-4">Ngày xử lý</dt><dd class="col-sm-8">@(Model.NgayXuLy?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa xử lý")</dd></div>
    <div class="row"><dt class="col-sm-4">Nhận xét xét duyệt</dt><dd class="col-sm-8">@(Model.NhanXetXetDuyet ?? "Chưa có")</dd></div>
    <div class="row"><dt class="col-sm-4">Người xử lý</dt><dd class="col-sm-8">@(Model.NguoiXuLy?.HoTen ?? "Chưa phân công")</dd></div>
</dl></div></div></div>
<div class="col-lg-4">@if (coTheHuy) { <form asp-action="Huy" asp-route-id="@Model.MaHoSo" method="post" data-confirm="Bạn chắc chắn muốn hủy hồ sơ này?"><button class="btn btn-outline-danger w-100" type="submit"><i class="bi bi-x-circle"></i>Hủy hồ sơ</button></form> }<a asp-action="Index" class="btn btn-light w-100 mt-2"><i class="bi bi-arrow-left"></i>Quay lại danh sách</a></div></div>
