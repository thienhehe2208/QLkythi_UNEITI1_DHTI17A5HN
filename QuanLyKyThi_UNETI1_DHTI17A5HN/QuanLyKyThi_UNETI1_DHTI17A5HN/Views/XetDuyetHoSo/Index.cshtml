   Họ và tên: Lương Thế Thiện
   Mã sinh viên: 21103101237
   Nội dung thực hiện: Giao diện danh sách, tìm kiếm, lọc,
   sắp xếp và phân trang hồ sơ cần xét duyệt (Module 4).
   ============================================================ *@
@model XetDuyetHoSoIndexViewModel

@{ ViewData["Title"] = "Xét duyệt hồ sơ"; }

<div class="page-header">
    <div><h1>Xét duyệt hồ sơ</h1><p class="page-subtitle">Tiếp nhận, tra cứu và xử lý hồ sơ đăng ký dự thi.</p></div>
</div>

<div class="card">
    <form method="get" class="filter-bar">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="row g-2 align-items-end">
            <div class="col-lg-4 col-md-6">
                <label asp-for="TuKhoa" class="form-label">Tìm kiếm</label>
                <div class="search-input"><i class="bi bi-search"></i><input asp-for="TuKhoa" class="form-control" placeholder="Thí sinh, kỳ thi hoặc chứng chỉ" /></div>
            </div>
            <div class="col-lg-2 col-md-6">
                <label asp-for="TrangThai" class="form-label">Trạng thái</label>
                <select asp-for="TrangThai" class="form-select" asp-items="Html.GetEnumSelectList<TrangThaiHoSo>()"><option value="">Tất cả trạng thái</option></select>
            </div>
            <div class="col-lg-3 col-md-6">
                <label asp-for="MaChungChi" class="form-label"></label>
                <select asp-for="MaChungChi" asp-items="Model.ChungChis" class="form-select"><option value="">Tất cả chứng chỉ</option></select>
            </div>
            <div class="col-lg-3 col-md-6">
                <label asp-for="SapXep" class="form-label"></label>
                <select asp-for="SapXep" class="form-select">
                    <option value="ngay_desc">Ngày nộp mới nhất</option>
                    <option value="ngay_asc">Ngày nộp cũ nhất</option>
                    <option value="ten_asc">Tên thí sinh A → Z</option>
                    <option value="ten_desc">Tên thí sinh Z → A</option>
                </select>
            </div>
            <div class="col-lg-3 col-md-4">
                <label asp-for="TuNgay" class="form-label"></label>
                <input asp-for="TuNgay" type="date" class="form-control" />
            </div>
            <div class="col-lg-3 col-md-4">
                <label asp-for="DenNgay" class="form-label"></label>
                <input asp-for="DenNgay" type="date" class="form-control" />
            </div>
            <div class="col-lg-3 col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-funnel"></i>Áp dụng</button>
                <a asp-action="Index" class="btn btn-light">Xóa lọc</a>
            </div>
        </div>
    </form>

    @if (Model.DanhSach.Count == 0)
    {
        <div class="empty-state"><i class="bi bi-file-earmark-check"></i><h2>Không có hồ sơ phù hợp</h2><p>Hãy thay đổi từ khóa hoặc điều kiện lọc.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-app align-middle">
                <thead><tr><th>Mã hồ sơ</th><th>Thí sinh</th><th>Kỳ thi / Chứng chỉ</th><th>Ngày nộp</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody>
                @foreach (var hoSo in Model.DanhSach)
                {
                    <tr>
                        <td>HS-@hoSo.MaHoSo</td>
                        <td><strong>@hoSo.HoTenThiSinh</strong></td>
                        <td><div>@hoSo.TenKyThi</div><div class="sub">@hoSo.TenChungChi</div></td>
                        <td>@hoSo.NgayNop.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><partial name="_BadgeTrangThai" model="hoSo.TrangThai" /></td>
                        <td class="text-end"><a asp-action="Details" asp-route-id="@hoSo.MaHoSo" class="btn btn-light"><i class="bi bi-eye"></i>Xem xét</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    <div class="card-footer"><partial name="_PhanTrang" model="Model.PhanTrang" /></div>
</div>
