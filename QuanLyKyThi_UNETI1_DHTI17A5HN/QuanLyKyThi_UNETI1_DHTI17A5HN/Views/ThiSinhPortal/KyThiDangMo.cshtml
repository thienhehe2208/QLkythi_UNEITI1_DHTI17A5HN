@model KyThiDangMoViewModel
@{
    ViewData["Title"] = "Kỳ thi đang mở";
}
<div class="candidate-page-heading">
    <div><span>ĐĂNG KÝ DỰ THI</span><h1>Các kỳ thi đang nhận hồ sơ</h1><p>Chọn kỳ thi phù hợp, nộp hồ sơ và theo dõi kết quả xét duyệt trực tuyến.</p></div>
</div>

@if (Model.DanhSach.Count == 0)
{
    <div class="candidate-empty"><i class="bi bi-calendar-x"></i><h2>Chưa có kỳ thi đang mở</h2><p>Vui lòng quay lại sau để xem các đợt đăng ký mới.</p></div>
}
else
{
    <div class="candidate-exam-grid">
        @foreach (var kyThi in Model.DanhSach)
        {
            var conLai = Math.Max(0, kyThi.SoChoThiToiDa - kyThi.SoChoDaGiu);
            <article class="candidate-exam-card">
                <div class="candidate-exam-head"><span>@(kyThi.TenNganhNghe ?? "Chứng chỉ")</span><span class="exam-open"><i class="bi bi-circle-fill"></i>Đang nhận hồ sơ</span></div>
                <h2>@kyThi.TenKyThi</h2>
                <p class="candidate-exam-certificate">@kyThi.TenChungChi · @kyThi.CapDoThi</p>
                <p class="candidate-exam-description">@(kyThi.MoTa ?? "Thông tin kỳ thi đang được cập nhật.")</p>
                <div class="candidate-exam-info">
                    <div><i class="bi bi-cash-coin"></i><span>Lệ phí<strong>@kyThi.LePhiDuThi.ToString("N0") đ</strong></span></div>
                    <div><i class="bi bi-hourglass-split"></i><span>Hạn đăng ký<strong>@kyThi.HanDangKy.ToString("dd/MM/yyyy")</strong></span></div>
                    <div><i class="bi bi-people"></i><span>Chỗ còn lại<strong>@conLai/@kyThi.SoChoThiToiDa</strong></span></div>
                </div>
                <div class="candidate-card-actions">
                    <a class="btn btn-outline-primary" asp-controller="KyThi" asp-action="Details" asp-route-id="@kyThi.MaKyThi">Xem chi tiết</a>
                    @if (kyThi.DaDangKy)
                    {
                        <a class="btn btn-success disabled" aria-disabled="true"><i class="bi bi-check2"></i>Đã đăng ký</a>
                    }
                    else
                    {
                        <a class="btn btn-primary" asp-controller="HoSoThiSinh" asp-action="Create" asp-route-maKyThi="@kyThi.MaKyThi">Đăng ký ngay</a>
                    }
                </div>
            </article>
        }
    </div>
}
