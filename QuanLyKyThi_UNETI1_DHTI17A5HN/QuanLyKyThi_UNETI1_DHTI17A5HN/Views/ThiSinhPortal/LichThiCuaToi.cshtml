@model LichThiCuaToiViewModel
@{
    ViewData["Title"] = "Lịch thi của tôi";
    var thangTruoc = Model.ThangHienThi.AddMonths(-1);
    var thangSau = Model.ThangHienThi.AddMonths(1);
    var soNgay = DateTime.DaysInMonth(Model.ThangHienThi.Year, Model.ThangHienThi.Month);
    var doLech = ((int)Model.ThangHienThi.DayOfWeek + 6) % 7;
    var tongONgay = (int)Math.Ceiling((doLech + soNgay) / 7d) * 7;
}
<div class="candidate-page-heading calendar-heading">
    <div><span>THỜI KHÓA BIỂU</span><h1>Lịch thi của tôi</h1><p>Lịch được cán bộ sắp xếp sau khi hồ sơ đủ điều kiện.</p></div>
    <div class="calendar-navigation">
        <a class="btn btn-light btn-icon" asp-action="LichThiCuaToi" asp-route-thang="@thangTruoc.Month" asp-route-nam="@thangTruoc.Year"><i class="bi bi-chevron-left"></i></a>
        <strong>Tháng @Model.ThangHienThi.Month/@Model.ThangHienThi.Year</strong>
        <a class="btn btn-light btn-icon" asp-action="LichThiCuaToi" asp-route-thang="@thangSau.Month" asp-route-nam="@thangSau.Year"><i class="bi bi-chevron-right"></i></a>
    </div>
</div>

<div class="candidate-calendar">
    <div class="calendar-weekdays">@foreach (var tenThu in new[] { "T2", "T3", "T4", "T5", "T6", "T7", "CN" }) { <span>@tenThu</span> }</div>
    <div class="calendar-grid">
        @for (var i = 0; i < tongONgay; i++)
        {
            var ngay = i - doLech + 1;
            if (ngay < 1 || ngay > soNgay) { <div class="calendar-day outside"></div> }
            else
            {
                var ngayHienTai = new DateTime(Model.ThangHienThi.Year, Model.ThangHienThi.Month, ngay);
                var lichTrongNgay = Model.DanhSach.Where(l => l.ThoiGianBatDau.Date == ngayHienTai).ToList();
                <div class="calendar-day @(ngayHienTai == DateTime.Today ? "today" : "")">
                    <span class="calendar-day-number">@ngay</span>
                    @foreach (var lich in lichTrongNgay)
                    {
                        <a class="calendar-event @(lich.TrangThai == TrangThaiLichThi.DaHuy ? "cancelled" : "")" asp-controller="LichThi" asp-action="Details" asp-route-id="@lich.MaLichThi" title="@lich.TenKyThi">
                            <strong>@lich.ThoiGianBatDau.ToString("HH:mm")</strong><span>@lich.TenKyThi</span>
                        </a>
                    }
                </div>
            }
        }
    </div>
</div>

<div class="candidate-section-title mt-4"><div><h2>Chi tiết lịch trong tháng</h2><p>@Model.DanhSach.Count lịch thi</p></div></div>
@if (Model.DanhSach.Count == 0)
{
    <div class="candidate-empty compact"><i class="bi bi-calendar2-check"></i><h2>Không có lịch thi trong tháng này</h2></div>
}
else
{
    <div class="candidate-schedule-list">
        @foreach (var lich in Model.DanhSach)
        {
            <article><div class="schedule-date"><strong>@lich.ThoiGianBatDau.Day</strong><span>Tháng @lich.ThoiGianBatDau.Month</span></div><div class="schedule-copy"><span>@lich.TenChungChi</span><h2>@lich.TenKyThi</h2><p><i class="bi bi-clock"></i>@lich.ThoiGianBatDau.ToString("HH:mm") – @lich.ThoiGianKetThuc.ToString("HH:mm") · <i class="bi bi-geo-alt"></i>@(lich.PhongThi ?? lich.DiaDiem)</p></div><partial name="_BadgeTrangThai" model="lich.TrangThai" /><a class="btn btn-light" asp-controller="LichThi" asp-action="Details" asp-route-id="@lich.MaLichThi">Chi tiết</a></article>
        }
    </div>
}
