   Họ và tên: Nguyễn Đắc Tiến
   Mã sinh viên: 23103100232
   Nội dung thực hiện: Xác nhận xóa tài khoản; hiển thị lý do nếu không được xóa.
   ============================================================ *@
@model TaiKhoan
@{
    ViewData["Title"] = "Xóa tài khoản";
    var lyDo = ViewBag.LyDoKhongXoa as string;
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Tài khoản</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.MaTaiKhoan">@Model.TenDangNhap</a></li>
                <li class="breadcrumb-item active" aria-current="page">Xóa</li>
            </ol>
        </nav>
        <h1>Xóa tài khoản</h1>
    </div>
</div>

<div class="card" style="max-width: 640px">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-3">
            <span class="avatar avatar-lg">@GiaoDienHelper.ChuCaiDau(Model.HoTen)</span>
            <div>
                <div class="fw-bold">@Model.HoTen</div>
                <div class="text-muted small">@Model.TenDangNhap · @Model.VaiTro.HienThi()</div>
                <div class="mt-1"><partial name="_BadgeTrangThai" model="Model.TrangThai" /></div>
            </div>
        </div>

        @if (lyDo is not null)
        {
            <div class="alert alert-warning d-flex gap-2 mb-0">
                <i class="bi bi-exclamation-triangle-fill"></i><div>@lyDo</div>
            </div>
        }
        else
        {
            <div class="alert alert-danger d-flex gap-2 mb-0">
                <i class="bi bi-exclamation-octagon-fill"></i>
                <div>Tài khoản sẽ bị xóa vĩnh viễn và không thể khôi phục. Nếu chỉ muốn ngừng sử dụng, hãy <strong>khóa</strong> tài khoản.</div>
            </div>
        }
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Details" asp-route-id="@Model.MaTaiKhoan" class="btn btn-light">Quay lại</a>
        @if (lyDo is null)
        {
            <form asp-action="Delete" asp-route-id="@Model.MaTaiKhoan" method="post">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i>Xóa vĩnh viễn</button>
            </form>
        }
    </div>
</div>
