@* ============================================================
   Họ và tên: Lương Thế Thiện
   Mã sinh viên: 21103101237
   Nội dung: Khung trình bày chung; bổ sung giao diện quản trị dùng
   chung cho Admin/Cán bộ khảo thí (topbar, sidebar và footer).
   ============================================================ *@
@{
    var session = Context.Session;
    var daDangNhap = session.DaDangNhap();
    var vaiTro = session.LayVaiTro();
    var hoTen = session.LayHoTen();
    var controllerHienTai = ViewContext.RouteData.Values["controller"]?.ToString();
    var actionHienTai = ViewContext.RouteData.Values["action"]?.ToString();
    var laQuanTri = vaiTro is VaiTro.Admin or VaiTro.CanBoKhaoThi;

    var menuNghiepVu = new List<(string Controller, string Action, string Icon, string Nhan)>
    {
        ("Home", "Index", "bi-grid-1x2", "Tổng quan"),
        ("ChungChi", "Index", "bi-award", "Chứng chỉ"),
        ("KyThi", "Index", "bi-calendar-event", "Kỳ thi"),
        ("HoSoDangKy", "Index", "bi-file-earmark-text", "Hồ sơ dự thi"),
        ("LichThi", "Index", "bi-clock-history", "Lịch thi"),
        ("KetQuaThi", "Index", "bi-clipboard-data", "Kết quả thi")
    };

    var menuQuanLy = new List<(string Controller, string Action, string Icon, string Nhan, VaiTro[] VaiTros)>
    {
        ("ThiSinh", "Index", "bi-person-lines-fill", "Thí sinh", new[] { VaiTro.Admin, VaiTro.CanBoKhaoThi }),
        ("XetDuyetHoSo", "Index", "bi-clipboard-check", "Xét duyệt hồ sơ", new[] { VaiTro.Admin, VaiTro.CanBoKhaoThi }),
        ("TaiKhoan", "Index", "bi-people", "Tài khoản", new[] { VaiTro.Admin })
    };

    bool DuocThay(VaiTro[] cacVaiTro) => vaiTro.HasValue && cacVaiTro.Contains(vaiTro.Value);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Quản lý kỳ thi chứng chỉ</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(laQuanTri ? "admin-body" : "candidate-body")">
    @if (laQuanTri)
    {
        <header class="admin-topbar">
            <a class="admin-brand" asp-controller="Home" asp-action="Index">
                <span class="app-brand-logo"><i class="bi bi-mortarboard"></i></span>
                <span class="admin-brand-text">QUẢN LÝ KỲ THI<small>Chứng chỉ &amp; hồ sơ dự thi</small></span>
            </a>
            <button class="admin-sidebar-toggle" type="button" data-sidebar-toggle aria-label="Thu gọn menu"><i class="bi bi-list"></i></button>
            <div class="admin-topbar-page"><span>@ViewData["Title"]</span></div>
            <div class="dropdown ms-auto">
                <button class="user-menu-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="avatar">@GiaoDienHelper.ChuCaiDau(hoTen)</span>
                    <span class="text-start user-menu-copy"><span class="ten d-block">@hoTen</span><span class="vai-tro">@vaiTro?.HienThi()</span></span>
                    <i class="bi bi-chevron-down small"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                    <li><a class="dropdown-item" asp-controller="Auth" asp-action="DoiMatKhau"><i class="bi bi-key me-2"></i>Đổi mật khẩu</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><form asp-controller="Auth" asp-action="DangXuat" method="post"><button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button></form></li>
                </ul>
            </div>
        </header>

        <div class="admin-shell">
            <aside class="admin-sidebar" id="adminSidebar">
                <nav class="admin-sidebar-nav" aria-label="Điều hướng quản trị">
                    <div class="sidebar-section-label">Nghiệp vụ</div>
                    @foreach (var m in menuNghiepVu)
                    {
                        <a class="sidebar-link @(controllerHienTai == m.Controller ? "active" : "")"
                           asp-controller="@m.Controller" asp-action="@m.Action"
                           aria-current="@(controllerHienTai == m.Controller ? "page" : null)">
                            <i class="bi @m.Icon"></i><span>@m.Nhan</span>
                        </a>
                    }
                    <div class="sidebar-section-label">Quản lý</div>
                    @foreach (var m in menuQuanLy.Where(m => DuocThay(m.VaiTros)))
                    {
                        <a class="sidebar-link @(controllerHienTai == m.Controller ? "active" : "")"
                           asp-controller="@m.Controller" asp-action="@m.Action"
                           aria-current="@(controllerHienTai == m.Controller ? "page" : null)">
                            <i class="bi @m.Icon"></i><span>@m.Nhan</span>
                        </a>
                    }
                </nav>
                <div class="sidebar-help">
                    <i class="bi bi-shield-check"></i>
                    <div><strong>Phiên làm việc an toàn</strong><span>Quyền truy cập theo vai trò</span></div>
                </div>
            </aside>
            <button class="admin-sidebar-overlay" type="button" data-sidebar-toggle aria-label="Đóng menu"></button>

            <div class="admin-main">
                <main role="main" class="admin-content"><div class="container-fluid">@RenderBody()</div></main>
                <footer class="admin-footer">
                    <div><strong>Hệ thống quản lý kỳ thi chứng chỉ</strong><span>Đề tài 28 · Nhóm 1 · Lớp TI17A5HN</span></div>
                    <span>&copy; 2026 · Trường Đại học Kinh tế - Kỹ thuật Công nghiệp</span>
                </footer>
            </div>
        </div>
    }
    else
    {
        <header class="app-navbar navbar navbar-expand-lg navbar-dark sticky-top">
            <div class="container-xxl">
                <a class="navbar-brand app-brand" asp-controller="Home" asp-action="Index">
                    <span class="app-brand-logo"><i class="bi bi-mortarboard"></i></span>
                    <span>Cổng chứng chỉ UNETI<small>Khám phá · Đăng ký · Dự thi</small></span>
                </a>
                @if (daDangNhap)
                {
                    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#menuChinh" aria-controls="menuChinh" aria-expanded="false" aria-label="Mở menu"><span class="navbar-toggler-icon"></span></button>
                    <div class="collapse navbar-collapse" id="menuChinh">
                        <ul class="navbar-nav app-nav me-auto">
                            <li class="nav-item"><a class="nav-link @(controllerHienTai == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i>Trang chủ</a></li>
                            <li class="nav-item"><a class="nav-link @(controllerHienTai == "ThiSinhPortal" && actionHienTai == "KhamPha" ? "active" : "")" asp-controller="ThiSinhPortal" asp-action="KhamPha"><i class="bi bi-patch-check"></i>Chứng chỉ</a></li>
                            <li class="nav-item"><a class="nav-link @(controllerHienTai == "ThiSinhPortal" && actionHienTai == "KyThiDangMo" ? "active" : "")" asp-controller="ThiSinhPortal" asp-action="KyThiDangMo"><i class="bi bi-calendar-plus"></i>Kỳ thi</a></li>
                            <li class="nav-item"><a class="nav-link @(controllerHienTai == "HoSoThiSinh" ? "active" : "")" asp-controller="HoSoThiSinh" asp-action="Index"><i class="bi bi-file-earmark-text"></i>Hồ sơ</a></li>
                            <li class="nav-item"><a class="nav-link @(controllerHienTai == "ThiSinhPortal" && actionHienTai == "LichThiCuaToi" ? "active" : "")" asp-controller="ThiSinhPortal" asp-action="LichThiCuaToi"><i class="bi bi-calendar3"></i>Lịch thi</a></li>
                            <li class="nav-item"><a class="nav-link @(controllerHienTai == "ThiSinhPortal" && actionHienTai == "LichSu" ? "active" : "")" asp-controller="ThiSinhPortal" asp-action="LichSu"><i class="bi bi-clock-history"></i>Lịch sử</a></li>
                            <li class="nav-item"><a class="nav-link @(controllerHienTai == "ThiSinhPortal" && actionHienTai == "YeuThich" ? "active" : "")" asp-controller="ThiSinhPortal" asp-action="YeuThich"><i class="bi bi-heart"></i>Yêu thích</a></li>
                        </ul>
                        <div class="dropdown">
                            <button class="user-menu-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="avatar">@GiaoDienHelper.ChuCaiDau(hoTen)</span>
                                <span class="text-start"><span class="ten d-block">@hoTen</span><span class="vai-tro">@vaiTro?.HienThi()</span></span>
                                <i class="bi bi-chevron-down small"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                <li><a class="dropdown-item" asp-controller="ThiSinh" asp-action="HoSoCaNhan"><i class="bi bi-person-vcard me-2"></i>Thông tin cá nhân</a></li>
                                <li><a class="dropdown-item" asp-controller="Auth" asp-action="DoiMatKhau"><i class="bi bi-key me-2"></i>Đổi mật khẩu</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><form asp-controller="Auth" asp-action="DangXuat" method="post"><button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button></form></li>
                            </ul>
                        </div>
                    </div>
                }
                else
                {
                    <a class="btn btn-light btn-sm ms-auto" asp-controller="Auth" asp-action="DangNhap"><i class="bi bi-box-arrow-in-right"></i>Đăng nhập</a>
                }
            </div>
        </header>
        <main role="main" class="app-content"><div class="container-xxl">@RenderBody()</div></main>
        <footer class="app-footer"><div class="container-xxl d-flex flex-wrap justify-content-between gap-2"><span>&copy; 2026 · Hệ thống quản lý kỳ thi chứng chỉ</span><span>Đề tài 28 · Nhóm 1 · TI17A5HN</span></div></footer>
    }

    <partial name="_ThongBao" />
    <div class="modal fade" id="modalXacNhan" tabindex="-1" aria-labelledby="modalXacNhanTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0"><h2 class="modal-title fs-5" id="modalXacNhanTitle">Xác nhận thao tác</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
            <div class="modal-body"><p class="mb-0 text-muted"></p></div>
            <div class="modal-footer border-0 pt-0"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button><button type="button" class="btn btn-primary" data-modal-ok>Đồng ý</button></div>
        </div></div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
