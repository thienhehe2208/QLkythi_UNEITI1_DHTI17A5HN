@* ============================================================
   Họ và tên: Nguyễn Đắc Tiến
   Mã sinh viên: 23103100232
   Nội dung thực hiện: Trang lỗi chung (404, 500...).
   ============================================================ *@
@model ErrorViewModel
@{
    int? maLoi = ViewBag.StatusCode as int?;
    ViewData["Title"] = maLoi == 404 ? "Không tìm thấy" : "Có lỗi xảy ra";
}

<div class="card">
    <div class="error-page">
        <div class="code">@(maLoi?.ToString() ?? "Lỗi")</div>
        @if (maLoi == 404)
        {
            <h1 class="h4 mt-3">Không tìm thấy trang hoặc dữ liệu</h1>
            <p class="text-muted">Đường dẫn có thể sai hoặc dữ liệu đã bị xóa.</p>
        }
        else
        {
            <h1 class="h4 mt-3">Đã có lỗi xảy ra</h1>
            <p class="text-muted">Vui lòng thử lại sau.</p>
        }
        @if (Model.ShowRequestId)
        {
            <p class="text-muted small">Mã yêu cầu: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i>Về trang chủ</a>
    </div>
</div>
