@* Họ và tên/Mã sinh viên: CHƯA CUNG CẤP. Nội dung: theo dõi xét duyệt, toàn bộ lịch và kết quả hợp lệ. *@
@model ChiTietHoSoThiViewModel
@{ ViewData["Title"] = "Theo dõi hồ sơ"; }
<div class="page-header"><div><nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Hồ sơ đã nộp</a></li><li class="breadcrumb-item active">HS-@Model.MaHoSo</li></ol></nav><h1>Theo dõi hồ sơ HS-@Model.MaHoSo</h1><p class="page-subtitle">@Model.HoTenThiSinh · @Model.TenKyThi</p></div>@if (Model.CoTheHuy) { <a asp-action="Huy" asp-route-id="@Model.MaHoSo" class="btn btn-outline-danger">Hủy đăng ký</a> }</div>
<div class="row g-3"><div class="col-lg-7"><div class="card"><div class="card-header">Thông tin đăng ký</div><div class="card-body"><dl class="info-list">
<div class="row"><dt class="col-sm-4">Kỳ thi</dt><dd class="col-sm-8">@Model.TenKyThi</dd></div><div class="row"><dt class="col-sm-4">Chứng chỉ</dt><dd class="col-sm-8">@Model.TenChungChi</dd></div><div class="row"><dt class="col-sm-4">Ngày nộp</dt><dd class="col-sm-8">@Model.NgayNop.ToString("dd/MM/yyyy HH:mm") (UTC+7)</dd></div><div class="row"><dt class="col-sm-4">Trạng thái</dt><dd class="col-sm-8"><partial name="_BadgeTrangThai" model="Model.TrangThai" /></dd></div><div class="row"><dt class="col-sm-4">Mục đích dự thi</dt><dd class="col-sm-8" style="white-space:pre-line">@Model.MucDichDuThi</dd></div><div class="row"><dt class="col-sm-4">Ghi chú</dt><dd class="col-sm-8" style="white-space:pre-line">@(Model.GhiChu ?? "Chưa có")</dd></div></dl></div></div></div>
<div class="col-lg-5"><div class="card"><div class="card-header">Xét duyệt hồ sơ</div><div class="card-body"><p><strong>Ngày xử lý:</strong> @(Model.NgayXuLy?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa có")</p><p class="mb-0" style="white-space:pre-line"><strong>Nhận xét:</strong> @(Model.NhanXetXetDuyet ?? "Chưa có nhận xét xét duyệt.")</p></div></div></div></div>
<div class="card mt-3"><div class="card-header">Lịch thi</div>
@if (Model.LichThis.Count == 0) { <div class="card-body text-muted">Hồ sơ chưa có lịch thi.</div> }
else { <div class="table-responsive"><table class="table table-app"><thead><tr><th>Thời gian (UTC+7)</th><th>Hình thức / Địa điểm</th><th>Giám thị</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var l in Model.LichThis) { <tr><td>@l.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")<div class="sub">đến @l.ThoiGianKetThuc.ToString("dd/MM/yyyy HH:mm")</div></td><td>@l.HinhThucThi.HienThi()<div class="sub text-break">@l.DiaDiemHoacLienKet · @l.PhongThi</div></td><td>@l.GiamThi</td><td><partial name="_BadgeTrangThai" model="l.TrangThai" /></td><td><a asp-controller="LichThi" asp-action="Details" asp-route-id="@l.MaLichThi" class="btn btn-light btn-sm">Chi tiết lịch</a></td></tr> }</tbody></table></div> }
</div>
<div class="card mt-3"><div class="card-header">Kết quả thi</div><div class="card-body">
@if (Model.KetQua is { } k) { <p><partial name="_BadgeTrangThai" model="k.KetQua" /></p><p><strong>Điểm đánh giá:</strong> @(k.DiemDanhGia?.ToString("0.##") ?? "Không sử dụng điểm")</p><p style="white-space:pre-line"><strong>Nhận xét:</strong> @(k.NhanXet ?? "Chưa có")</p><p class="text-muted">Cập nhật: @k.NgayCapNhat.ToString("dd/MM/yyyy HH:mm") (UTC+7)</p><a asp-controller="KetQuaThi" asp-action="Details" asp-route-id="@k.MaKetQuaThi" class="btn btn-light">Chi tiết kết quả</a> }
else { <p class="text-muted mb-0">Chưa có kết quả được công bố.</p> }
</div></div>
