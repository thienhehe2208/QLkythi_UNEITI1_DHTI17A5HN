@* Họ và tên/Mã sinh viên: CHƯA CUNG CẤP. Nội dung: chọn kỳ thi từ Database và nộp hồ sơ, GET chọn không ghi dữ liệu. *@
@model NopHoSoThiViewModel
@{ ViewData["Title"] = "Nộp hồ sơ dự thi"; }
<div class="page-header"><div><h1>Nộp hồ sơ đăng ký dự thi</h1><p class="page-subtitle">Chọn kỳ thi đang nhận hồ sơ và kiểm tra thông tin trước khi nộp.</p></div><a asp-controller="ThiSinh" asp-action="HoSoCaNhan" class="btn btn-light">Hồ sơ cá nhân</a></div>
@if (Model.LyDoKhongTheNop.Any()) { <div class="alert alert-warning"><ul class="mb-0">@foreach (var lyDo in Model.LyDoKhongTheNop) { <li>@lyDo</li> }</ul></div> }
<div class="row g-3"><div class="col-lg-8">
<div class="card mb-3"><form asp-action="Create" method="get" class="card-body"><label for="chonKyThi" class="form-label">Kỳ thi đang nhận hồ sơ</label><div class="d-flex gap-2"><select id="chonKyThi" name="maKyThi" class="form-select"><option value="">Chọn kỳ thi</option>@foreach (var k in Model.KyThis) { <option value="@k.Value" selected="@(k.Value == Model.MaKyThi?.ToString())">@k.Text</option> }</select><button class="btn btn-light text-nowrap">Xem thông tin</button></div>@if (Model.KyThis.Count == 0) { <p class="text-muted mt-2 mb-0">Hiện chưa có kỳ thi đang mở và còn hạn nhận hồ sơ.</p> }</form></div>
@if (Model.KyThi is { } kyThi) { <div class="card mb-3"><div class="card-header">@kyThi.TenKyThi</div><div class="card-body"><p><strong>Chứng chỉ:</strong> @kyThi.TenChungChi</p><p><strong>Cấp độ:</strong> @kyThi.CapDoThi · <strong>Điểm đầu vào tối thiểu:</strong> @kyThi.DiemDauVaoToiThieu</p><p><strong>Nhận hồ sơ (UTC+7):</strong> @kyThi.NgayBatDauDangKy.ToString("dd/MM/yyyy HH:mm") đến @kyThi.HanDangKy.ToString("dd/MM/yyyy HH:mm")</p><p class="@(kyThi.ConNhanHoSo ? "text-success" : "text-danger")">@(kyThi.ConNhanHoSo ? "Đang nhận hồ sơ" : "Không còn nhận hồ sơ")</p><p style="white-space:pre-line"><strong>Điều kiện dự thi:</strong> @(kyThi.DieuKienDuThi ?? "Theo thông báo kỳ thi.")</p><p class="text-muted mb-0" style="white-space:pre-line">@kyThi.MoTaKyThi</p></div></div> }
<form asp-action="Create" method="post" class="card"><div class="card-header">Thông tin đăng ký</div><div class="card-body">
<input asp-for="MaKyThi" type="hidden" /><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><span asp-validation-for="MaKyThi" class="text-danger d-block mb-2"></span>
<div class="mb-3"><label asp-for="MucDichDuThi" class="form-label required"></label><textarea asp-for="MucDichDuThi" rows="4" maxlength="1000" class="form-control"></textarea><span asp-validation-for="MucDichDuThi" class="text-danger"></span></div>
<div><label asp-for="GhiChu" class="form-label"></label><textarea asp-for="GhiChu" rows="3" maxlength="1000" class="form-control"></textarea><span asp-validation-for="GhiChu" class="text-danger"></span></div>
</div><div class="card-footer d-flex gap-2"><button class="btn btn-primary" disabled="@(Model.KyThi == null || Model.LyDoKhongTheNop.Any())">Nộp hồ sơ</button><a asp-action="Index" class="btn btn-light">Hồ sơ đã nộp</a></div></form>
</div><div class="col-lg-4"><div class="card"><div class="card-header">Thí sinh</div><div class="card-body"><p class="fw-semibold">@(Model.CaNhan.DaKhaiBao ? Model.CaNhan.HoTen : "Chưa khai báo hồ sơ cá nhân")</p><p>@Model.CaNhan.Email<br />@Model.CaNhan.SoDienThoai</p><a asp-controller="ThiSinh" asp-action="CapNhatHoSo">Cập nhật thông tin cá nhân</a><hr /><p class="text-muted small mb-0">Hồ sơ nộp thành công sẽ ở trạng thái Chờ duyệt. Bạn có thể theo dõi quá trình xét duyệt trong Hồ sơ đã nộp.</p></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
