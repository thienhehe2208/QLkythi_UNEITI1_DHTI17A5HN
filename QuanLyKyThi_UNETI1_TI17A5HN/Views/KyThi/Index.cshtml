 @model IEnumerable<QuanLyKyThi_UNETI1_TI17A5HN.Models.KyThi>

@{
    ViewData["Title"] = "Danh sách kỳ thi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Quản lý kỳ thi</h2>
        <a asp-action="Create" class="btn btn-primary">
            + Thêm kỳ thi
        </a>
    </div>

    <div class="alert alert-info">
        Danh sách các kỳ thi trong hệ thống.
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning">
            Chưa có kỳ thi nào. Hãy chọn "Thêm kỳ thi" để bắt đầu.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Mã kỳ thi</th>
                        <th>Tên kỳ thi</th>
                        <th>Mã chứng chỉ</th>
                        <th>Cấp độ</th>
                        <th>Số chỗ tối đa</th>
                        <th>Ngày bắt đầu</th>
                        <th>Hạn đăng ký</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MaKyThi</td>
                            <td>@item.TenKyThi</td>
                            <td>@item.MaChungChi</td>
                            <td>@item.CapDoThi</td>
                            <td>@item.SoChoThiToiDa</td>
                            <td>@item.NgayBatDauDangKy.ToString("dd/MM/yyyy")</td>
                            <td>@item.HanDangKy.ToString("dd/MM/yyyy")</td>
                            <td>@item.TrangThai</td>
                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@item.MaKyThi"
                                   class="btn btn-sm btn-info mb-1">
                                    Chi tiết
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.MaKyThi"
                                   class="btn btn-sm btn-warning mb-1">
                                    Sửa
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.MaKyThi"
                                   class="btn btn-sm btn-danger mb-1">
                                    Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>